# Firebase web configuration identifies the project; it is not an admin credential.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# NEVER put provider secrets in EXPO_PUBLIC variables.

# Optional web App Check public site key; required for production AI on web.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Enable only for native builds configured with matching Firebase app files.
EXPO_PUBLIC_NATIVE_APP_CHECK_ENABLED=false
