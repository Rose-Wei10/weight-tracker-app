rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function active(uid) { return owner(uid) && !exists(/databases/$(database)/documents/_accountBlocks/$(uid)) && (!exists(/databases/$(database)/documents/users/$(uid)) || get(/databases/$(database)/documents/users/$(uid)).data.get('deleting', false) == false); }
  function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function number(value, low, high) { return value is number && value >= low && value <= high; }
  function profile(p) { return p is map && p.keys().hasOnly(['height','weight','age','gender','activity','intent','target','tdee']) && number(p.height,100,250) && number(p.weight,20,500) && p.age is int && p.age >= 18 && p.age <= 100 && p.gender in ['female','male'] && p.activity in [1.2,1.375,1.55,1.725] && p.intent in ['maintain','lose','gain'] && number(p.target,1200,6000) && number(p.tdee,1,10000); }
  function settings(d) {
   return (!('goal' in d) || (d.goal is string && d.goal.size() <= 20))
    && (!('goalWeight' in d) || (d.goalWeight is string && d.goalWeight.size() <= 20))
    && (!('units' in d) || d.units in ['metric','imperial'])
    && (!('language' in d) || d.language in ['en','zh'])
    && (!('aiConsent' in d) || d.aiConsent is bool)
    && (!('onboardingComplete' in d) || d.onboardingComplete is bool);
  }
  function validWeight(d) { return d.keys().hasOnly(['weight','date','waist','createdAt','updatedAt']) && number(d.weight,20,500) && date(d.date) && (!('waist' in d) || number(d.waist,20,300)) && (!('updatedAt' in d) || d.updatedAt == request.time); }
  function validFood(d) {
   return d.keys().hasOnly(['name','date','calories','quantity','protein','carbs','fat','meal','source','createdAt','updatedAt'])
    && d.name is string && d.name.size()>0 && d.name.size()<=120 && date(d.date)
    && number(d.calories,0,10000) && number(d.quantity,0.001,100)
    && number(d.protein,0,1000) && number(d.carbs,0,2000) && number(d.fat,0,1000)
    && d.meal in ['breakfast','lunch','dinner','snack'] && d.source in ['manual','reference','ai']
    && (!('updatedAt' in d) || d.updatedAt == request.time);
  }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if active(uid) && request.resource.data.keys().hasOnly(['goal','goalWeight','units','language','profile','aiConsent','onboardingComplete']) && settings(request.resource.data) && (!('profile' in request.resource.data) || profile(request.resource.data.profile));
   // Validate changed profile fields while preserving unrelated legacy fields.
   allow update: if active(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goal','goalWeight','units','language','profile','aiConsent','onboardingComplete']) && settings(request.resource.data) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profile']) || profile(request.resource.data.profile));
   allow delete: if false;
   match /weights/{id} {
    allow read: if owner(uid);
    allow create: if active(uid) && validWeight(request.resource.data) && id == request.resource.data.date && getAfter(/databases/$(database)/documents/users/$(uid)/weightDays/$(id)).data.entryId == id;
    allow update: if active(uid) && validWeight(request.resource.data) && request.resource.data.date == resource.data.date;
    allow delete: if active(uid);
   }
   match /weightDays/{dateId} {
    allow read: if owner(uid);
    allow create, update: if active(uid) && date(dateId) && request.resource.data.keys().hasOnly(['entryId']) && request.resource.data.entryId is string && request.resource.data.entryId.size() <= 150 && (!exists(/databases/$(database)/documents/users/$(uid)/weightDays/$(dateId)) || request.resource.data.entryId == resource.data.entryId) && getAfter(/databases/$(database)/documents/users/$(uid)/weights/$(request.resource.data.entryId)).data.date == dateId;
    allow delete: if active(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid)/weights/$(resource.data.entryId));
   }
   match /foods/{id} { allow read: if owner(uid); allow create,update: if active(uid) && validFood(request.resource.data); allow delete: if active(uid); }
   match /templates/{id} { allow read: if owner(uid); allow create,update: if active(uid) && validFood(request.resource.data); allow delete: if active(uid); }
  }
  match /{document=**} { allow read,write: if false; }
 }
}
