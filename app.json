{
  "expo": {
    "name": "Forma",
    "slug": "weight-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/forma-icon.png",
    "scheme": "weighttracker",
    "userInterfaceStyle": "automatic",
    // "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weir0210.weight-tracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/forma-icon.png",
        "backgroundColor": "#F5F6F0"
      },
      // "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.weir0210.weighttracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/forma-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/forma-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F0",
          "dark": {
            "backgroundColor": "#101C18"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a meal photo to estimate nutrition after your confirmation.",
          "cameraPermission": "Take a meal photo to estimate nutrition after your confirmation.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
